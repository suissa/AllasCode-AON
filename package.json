{
  "name": "@allascode.institute/aon",
  "version": "1.0.0",
  "description": "Adaptive Observability Negotiation Protocol (AONP) and CrystalBox interactive runtime self-healing engine. A foundational pillar of the AllasCode Architecture.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "CONTEXT.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test --import tsx test/aon-stream.test.ts test/healer.test.ts test/crystal-box.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "allascode",
    "allascode-institute",
    "aon",
    "aonp",
    "rfc",
    "observability",
    "streaming",
    "ndjson",
    "self-healing",
    "crystalbox",
    "agentic-ai",
    "human-in-the-loop",
    "human-dev-in-the-loop",
    "content-negotiation",
    "full-agent-stack"
  ],
  "author": "AllasCode.Institute",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suissa/AllasCode-AON.git"
  },
  "bugs": {
    "url": "https://github.com/suissa/AllasCode-AON/issues"
  },
  "homepage": "https://github.com/suissa/AllasCode-AON#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
